#!/bin/bash

set -eo pipefail

new_changelog=$OUTPUTDIR/${IMAGE_ID}_${IMAGE_VERSION}.changelog
diff_path=${new_changelog}.diff

if ! [ -e $new_changelog ] ; then
  >&2 echo "Missing new changelog, skipping diff"
  exit 0
fi

if ! [ -f $SRCDIR/cache/latest.changelog.xz ] || ! [ -s $SRCDIR/cache/latest.changelog.xz ] ; then
  >&2 echo "Warning: Previous changelog not found"
fi

# --label: the default headers embed the process-substitution fd path and a
# wall-clock mtime, making $diff_path non-reproducible.
diff -u --label previous.changelog --label current.changelog \
  <(xzcat $SRCDIR/cache/latest.changelog.xz) $new_changelog > $diff_path || true

if ! [ -s $diff_path ] ; then
  echo 'No changes in OS packages' | tee $diff_path $diff_path.md
fi

# The AI summary (diff_path.md) is generated separately, outside of mkosi's
# sandbox, since postoutput scripts have no network access even with
# WithNetwork=yes. See .github/workflows/mkosi.yml.
