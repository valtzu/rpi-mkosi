[Transfer]
ProtectVersion=%A
Verify=no

[Source]
Type=url-file
Path=https://github.com/valtzu/rpi-mkosi/releases/latest/download
MatchPattern=%M_@v.usr-%a-verity.@u.raw.xz \
             %M_@v.usr-%a-verity.@u.raw.zst

[Target]
Type=partition
Path=auto
MatchPattern=%M_@v_verity
MatchPartitionType=usr-verity
PartitionFlags=0
ReadOnly=1
