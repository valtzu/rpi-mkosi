#!/bin/bash -ex

CACHEDIR=$SRCDIR/cache
TMPDIR=$(mktemp -d)
trap "rm -rf -- $TMPDIR" EXIT
cp -af $CACHEDIR/firmware $TMPDIR/firmware
cd $TMPDIR/firmware

unzip -o $CACHEDIR/rpi_uefi.zip RPI_EFI.fd

virt-fw-vars \
  -i ./RPI_EFI.fd \
  -o ./RPI_EFI.fd \
  --set-json $SRCDIR/efivars.json \
  --no-microsoft \
  --secure-boot \
  --enroll-cert $SRCDIR/mkosi.crt \
  --add-db a0baa8a3-041d-48a8-bc87-c36d121b5e3d $SRCDIR/mkosi.crt

# rpi-eeprom-digest stamps "ts: $(date -u +%s)" into the .sig files unless
# SOURCE_DATE_EPOCH is set, and bootconf.sig is embedded verbatim into
# pieeprom.upd. Without this every build produced a byte-different image, so the
# bootloader self-update reflashed the EEPROM on the next boot. The CI pipeline
# exports a commit-pinned SOURCE_DATE_EPOCH; honour it when present. Otherwise
# (local dev) fall back to the newest mtime of the inputs that actually end up in
# the EEPROM: stable across rebuilds of an unchanged tree (no reflash), advances
# the moment bootconf.txt, the signing key or the pinned EEPROM version is edited
# (reflash), no commit required.
export SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH:-$(stat -c %Y $SRCDIR/bootconf.txt $SRCDIR/mkosi.conf $SRCDIR/mkosi.key | sort -n | tail -1)}

# Only the config is RSA-signed; pieeprom.sig is a corruption guard, not a signature.
cat $CACHEDIR/eeprom/rpi-eeprom-digest | sh -s - -k $SRCDIR/mkosi.key -i $SRCDIR/bootconf.txt -o $TMPDIR/bootconf.sig
# --pubkey would accept mkosi.key itself; keep the private key out of the tool.
openssl rsa -in $SRCDIR/mkosi.key -pubout -out $TMPDIR/mkosi.pub
python3 $CACHEDIR/eeprom/rpi-eeprom-config \
  --config $SRCDIR/bootconf.txt \
  --digest $TMPDIR/bootconf.sig \
  --pubkey $TMPDIR/mkosi.pub \
  --out $TMPDIR/pieeprom.upd \
  $CACHEDIR/eeprom/pieeprom.bin
cat $CACHEDIR/eeprom/rpi-eeprom-digest | sh -s - -i $TMPDIR/pieeprom.upd -o $TMPDIR/pieeprom.sig

# Emitted into $OUTPUTDIR (-> mkosi.output/) as well so it can be served over
# TFTP/HTTP for netboot, not just baked into the ESP.
# -N pins the volume serial (else mformat derives it from wall-clock time); the
# explicit + sorted mcopy order pins the FAT directory layout (mcopy -s recurses
# in readdir order, which is not stable).
truncate -s 8M $OUTPUTDIR/boot.img
mformat -i $OUTPUTDIR/boot.img -L 16 -N "$(printf '%08x' "$SOURCE_DATE_EPOCH")" ::
mcopy -i $OUTPUTDIR/boot.img start4.elf fixup4.dat bcm2711-rpi-4-b.dtb RPI_EFI.fd $SRCDIR/config.txt ::
mmd -i $OUTPUTDIR/boot.img ::/overlays
LC_ALL=C mcopy -i $OUTPUTDIR/boot.img overlays/* ::/overlays/
mcopy -i $OUTPUTDIR/boot.img $TMPDIR/pieeprom.upd $TMPDIR/pieeprom.sig ::
cat $CACHEDIR/eeprom/rpi-eeprom-digest | sh -s - -k $SRCDIR/mkosi.key -i $OUTPUTDIR/boot.img -o $OUTPUTDIR/boot.sig

install -m 0755 $CACHEDIR/k3s $BUILDROOT/usr/bin/k3s
install -m 0400 -D $OUTPUTDIR/boot.sig $BUILDROOT/efi/boot.sig
# --sparse=never keeps the shipped copy hole-free so `tar --sparse` (hardcoded by
# mkosi) stores it as a plain member. Its sparse encoding embeds the archiving
# PID in the member name (GNUSparseFile.<pid>), which breaks reproducibility.
install -d -m 0700 $BUILDROOT/efi
cp --sparse=never $OUTPUTDIR/boot.img $BUILDROOT/efi/boot.img
chmod 0400 $BUILDROOT/efi/boot.img

mkdir -pm 0700 $BUILDROOT/root/.ssh
# todo: use $(jq -r '.SshKey' $MKOSI_CONFIG) instead of hardcoded mkosi.key once the fix is released https://github.com/systemd/mkosi/pull/2574
ssh-keygen -f $SRCDIR/mkosi.key -y > $BUILDROOT/root/.ssh/authorized_keys
chmod 0700 $BUILDROOT/root/.ssh/authorized_keys

# dev profile: point sysupdate and journal-upload at this build host (mkosi
# serve / systemd-journal-remote). The address is resolved in mkosi.sync
# (which has host networking) and read back here.
dev_transfers=$(grep -rl '@BUILD_HOST@' "$BUILDROOT"/usr/lib/ 2>/dev/null || true)
if [ -n "$dev_transfers" ]; then
  host=${SYSUPDATE_HOST:-$(cat "$SRCDIR/cache/build-host" 2>/dev/null || true)}
  [ -n "$host" ] || { echo "dev profile: $SRCDIR/cache/build-host missing (mkosi.sync should have written it)" >&2; exit 1; }
  sed -i "s/@BUILD_HOST@/$host/g" $dev_transfers
fi
