[Unit]
Description=Log in to the iSCSI root (iBFT or kernel cmdline)
DefaultDependencies=no
# Only relevant when the Pi firmware handed off an iSCSI boot: either an iBFT
# is present, or the dev kernel cmdline carries iscsi_portal=. On SD/USB boots
# neither is true and this is skipped.
ConditionPathExists=|/sys/firmware/ibft/target0
ConditionKernelCommandLine=|iscsi_portal
After=systemd-modules-load.service
Before=initrd-root-device.target
Wants=initrd-root-device.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/initrd-iscsi-root

[Install]
WantedBy=initrd-root-device.target
