# Copy to dev.local.conf (untracked) for `mkosi --profile dev`.

# The Pi's onboard Ethernet MAC. EDK2 only loads the baked iSCSI attempt if this
# matches the NIC exactly. Read it off the Pi (`ip link`) or the sticker.
PI_MAC=dc:a6:32:00:00:00

# Optional: override the iSCSI portal (defaults to this machine's primary IP,
# `hostname -I`). Set it if auto-detection picks the wrong interface.
#DEV_HOST=192.168.2.2
