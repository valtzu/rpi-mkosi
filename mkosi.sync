#!/bin/bash -e

dist_url='https://github.com/valtzu/rpi-mkosi/releases/latest/download'
latest_changelog=$(curl -sL "$dist_url/SHA256SUMS"|grep -oE '\S+changelog\.xz$')

curl -fLZ \
  --variable "dl_dir=$SRCDIR/cache" \
  --variable "dist_url=$dist_url" \
  --variable "latest_changelog=$latest_changelog" \
  --variable "uefi_version=$UEFI_VERSION" \
  --variable "firmware_ref=$FIRMWARE_REF" \
  --variable "eeprom_ref=$EEPROM_REF" \
  --variable "eeprom_version=$EEPROM_VERSION" \
  --config $SRCDIR/curl.txt

ln -sf $latest_changelog $SRCDIR/cache/latest.changelog.xz
ln -sf rpi_uefi_${UEFI_VERSION}.zip $SRCDIR/cache/rpi_uefi.zip
ln -sf pieeprom-${EEPROM_VERSION}.bin $SRCDIR/cache/eeprom/pieeprom.bin

# dev: EDK2 HTTP-boots iPXE's arm64 secure-boot snponly.efi (served locally by
# `mkosi serve`), and its test-signing cert is enrolled into db. iPXE rotates
# that key ~monthly - `rm cache/ipxe/testsign.crt` to force a refetch if HTTP
# boot starts failing image verification.
if printf '%s' "$PROFILES" | grep -qw dev; then
  mkdir -p $SRCDIR/cache/ipxe
  for f in snponly.efi testsign.crt; do
    [ -e $SRCDIR/cache/ipxe/$f ] || curl -fL -o $SRCDIR/cache/ipxe/$f http://boot.ipxe.org/arm64-efi-sb/$f
  done
fi
