#!/bin/bash -ex

# Build the rpi-crypto-passphrase kernel module: it only needs
# rpi_firmware_property(), which is exported by the upstream in-tree
# raspberrypi-firmware driver, so it builds against the installed kernel's
# own headers - no downstream kernel source tree required.

kver=$(basename /usr/lib/modules/*)
installed_kernel=/usr/lib/modules/$kver/build

mkdir -p $installed_kernel/certs $installed_kernel/output
ln -s $SRCDIR/mkosi.key $installed_kernel/certs/signing_key.pem
ln -s $SRCDIR/mkosi.crt $installed_kernel/certs/signing_key.x509
ln -s $SRCDIR/mkosi.key $installed_kernel/output/signing_key.pem
ln -s $SRCDIR/mkosi.crt $installed_kernel/output/signing_key.x509

moddir=$(mktemp -d)
cp mkosi.profiles/disk/rpi-crypto-passphrase.c mkosi.profiles/disk/rpi-crypto-passphrase.h $moddir/
cat > $moddir/Makefile <<'EOF'
obj-m := rpi-crypto-passphrase.o
EOF

make -j$(nproc) -C $installed_kernel M=$moddir modules
make -j$(nproc) -C $installed_kernel M=$moddir modules_install INSTALL_MOD_PATH=$DESTDIR INSTALL_MOD_DIR=extra/drivers/misc
