#!/bin/sh
# Same as the top-level mkosi.version, but the bare tag only, no
# -<commits>-g<sha>: GPT partition labels cap at 36 chars and
# system_<version>_verity_sig eats 18 of those - the full descriptor alone
# can already blow that budget a few commits past a tag. Sits at this path so
# it overrides the top-level mkosi.version whenever the dev profile is
# active - same pattern as mkosi.sync/mkosi.finalize elsewhere in this repo.
v=$(git describe --tags --always --match '[0-9]*' --abbrev=0 2>/dev/null || echo 0)
[ -z "$(git status --porcelain 2>/dev/null)" ] || v="$v-${SOURCE_DATE_EPOCH:-$(date +%s)}"
printf '%s\n' "$v"
